# ================================================
# Resume Analyzer Backend - Environment Config
# ================================================

# Server Port
PORT=5000

# Environment: 'development' or 'production'
FLASK_ENV=production

# CORS allowed origins (comma-separated or '*' for public API)
CORS_ORIGINS=*

# Optional: Google Gemini API Key for AI Resume Coach & STAR Rewrites
# If omitted, the system seamlessly uses the high-precision offline heuristic engine.
# GEMINI_API_KEY=your_gemini_api_key_here
